{
  "description": "Cases the cdnjs auto-update and scripts/checker must agree on. files: tarball entry names and the files published from them. ignoreVersions: versions each list ignores and keeps, as recorded with gobwas/glob v0.2.3.",
  "files": [
    {
      "name": "extglob alternatives and negation (dayjs)",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["dayjs*", "+(locale|plugin)/!(*.ts)"]
            }
          ]
        }
      },
      "entries": [
        "package/dayjs.min.js",
        "package/locale/fr.js",
        "package/locale/fr.d.ts",
        "package/plugin/utc.js",
        "package/esm/index.js",
        "package/package.json"
      ],
      "published": ["dayjs.min.js", "locale/fr.js", "locale/fr.min.js", "plugin/utc.js", "plugin/utc.min.js"]
    },
    {
      "name": "basePath is removed",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "dist",
              "files": ["*.js", "utils/*.js"]
            }
          ]
        }
      },
      "entries": [
        "package/dist/function-plot.js",
        "package/dist/utils/plotter.js",
        "package/index.js",
        "package/dist/deep/x/y.js"
      ],
      "published": ["function-plot.js", "function-plot.min.js", "utils/plotter.js", "utils/plotter.min.js"]
    },
    {
      "name": "the top directory of a git tarball is removed",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "lib",
              "files": ["*.js"]
            }
          ]
        }
      },
      "entries": [
        "mikehostetler-amplify-0123abc/lib/amplify.js",
        "mikehostetler-amplify-0123abc/lib/amplify.min.js",
        "mikehostetler-amplify-0123abc/src/amplify.js"
      ],
      "published": ["amplify.js", "amplify.min.js"]
    },
    {
      "name": "globstar matches nested files, star does not match a leading dot",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "dist",
              "files": ["**/*.css"]
            }
          ]
        }
      },
      "entries": [
        "package/dist/a.css",
        "package/dist/themes/dark/b.css",
        "package/dist/.hidden.css",
        "package/dist/.cache/c.css"
      ],
      "published": ["a.css", "a.min.css", "themes/dark/b.css", "themes/dark/b.min.css"]
    },
    {
      "name": "a dotfile named exactly is matched",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": [".eslintrc.json"]
            }
          ]
        }
      },
      "entries": ["package/.eslintrc.json"],
      "published": [".eslintrc.json"]
    },
    {
      "name": "the first matching glob decides the basePath",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "dist",
              "files": ["*.js"]
            },
            {
              "basePath": "",
              "files": ["dist/*.js", "LICENSE"]
            }
          ]
        }
      },
      "entries": ["package/dist/x.js", "package/LICENSE"],
      "published": ["LICENSE", "x.js", "x.min.js"]
    },
    {
      "name": "only the first occurrence of basePath is removed",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "js",
              "files": ["**/*.js"]
            }
          ]
        }
      },
      "entries": ["package/js/js/a.js"],
      "published": ["js/a.js", "js/a.min.js"]
    },
    {
      "name": "a minified copy the tarball ships is listed once",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["*.js", "*.css"]
            }
          ]
        }
      },
      "entries": ["package/a.js", "package/a.min.js", "package/b.css", "package/b.min.css"],
      "published": ["a.js", "a.min.js", "b.css", "b.min.css"]
    },
    {
      "name": "optimization false disables minified copies per type",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["*"]
            }
          ]
        },
        "optimization": {
          "js": false,
          "png": false
        }
      },
      "entries": ["package/a.js", "package/b.css", "package/c.png", "package/d.mjs", "package/e.json"],
      "published": ["a.js", "b.css", "b.min.css", "c.png", "d.mjs", "e.json"]
    },
    {
      "name": "extensions match case-insensitively and keep their case",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["*.*"]
            }
          ]
        }
      },
      "entries": ["package/A.JS", "package/B.Min.Css", "package/C.CSS"],
      "published": ["A.JS", "A.min.JS", "B.Min.Css", "C.CSS", "C.min.CSS"]
    },
    {
      "name": "only .js and .css get a minified copy",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["*"]
            }
          ]
        }
      },
      "entries": ["package/a.mjs", "package/b.cjs", "package/c.ts", "package/d.scss", "package/e.js.map"],
      "published": ["a.mjs", "b.cjs", "c.ts", "d.scss", "e.js.map"]
    },
    {
      "name": "a name without a directory is matched whole",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "",
              "files": ["*.js"]
            }
          ]
        }
      },
      "entries": ["loose.js"],
      "published": ["loose.js", "loose.min.js"]
    },
    {
      "name": "parent directory segments do not match a glob",
      "pkg": {
        "autoupdate": {
          "fileMap": [
            {
              "basePath": "dist",
              "files": ["**/*.js"]
            }
          ]
        }
      },
      "entries": ["package/dist/../../glob/index.js", "package/dist/ok.js"],
      "published": ["ok.js", "ok.min.js"]
    }
  ],
