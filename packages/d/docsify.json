{
  "name": "docsify",
  "filename": "dist/docsify.min.js",
  "description": "A magical documentation generator.",
  "homepage": "https://docsify.js.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docsifyjs/docsify.git"
  },
  "keywords": [
    "doc",
    "docs",
    "documentation",
    "creator",
    "generator"
  ],
  "autoupdate": {
    "source": "npm",
    "target": "docsify",
    "fileMap": [
      {
        "basePath": "",
        "files": [
          "dist/**/*.{js,css,js.map,css.map}",
          "lib/**/*.{js,css}",
          "src/**/*.{js,ts,css,js.map,css.map,d.ts.map}",
          "themes/**/*.css"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "docsify",
      "email": "maintainers@docsifyjs.org",
      "url": "https://github.com/docsifyjs"
    },
    {
      "name": "Luffy",
      "email": "lufei@docsifyjs.org",
      "url": "https://github.com/sy-records"
    }
  ]
}
