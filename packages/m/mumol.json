{
  "name": "mumol",
  "description": "A WebGPU molecular viewer built on Three.js.",
  "keywords": ["molecule", "protein", "visualization", "webgpu", "three.js"],
  "license": "MIT",
  "homepage": "https://github.com/Revanta-Inc/mumol",
  "repository": {
