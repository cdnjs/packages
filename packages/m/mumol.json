        "files": ["*.js", "mumol.d.ts", "assets/*.js"]
      }
    ]
  },
  "optimization": {
    "js": false
  },
  "authors": [
    {
      "name": "Moritz Onken",
      "email": "onken@netcubed.de"
    }
  ]
