{
  "name": "jsondiffpatch",
  "filename": "index.js",
  "description": "Diff & Patch for Javascript objects",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamine/jsondiffpatch.git"
  },
  "keywords": [
    "json",
    "diff",
    "patch"
  ],
  "license": "MIT",
  "autoupdate": {
    "source": "npm",
    "target": "jsondiffpatch",
    "fileMap": [
      {
        "basePath": "lib",
        "files": [
          "!(with-text-diffs).js",
          "assertions/*.js",
          "contexts/*.js",
          "filters/*.js",
          "formatters/*.js",
          "moves/*.js",
          "formatters/styles/*.css"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "Benjamin Eidelman",
      "email": "beneidel@gmail.com"
    }
  ]
}
