    "minimal",
    "svg",
    "vector",
    "performance",
    "indicator",
    "measure",
    "dashboard",
    "javascript",
    "plugin"
  ],
  "license": "MIT",
  "homepage": "http://justgage.com/",
  "autoupdate": {
    "source": "npm",
    "target": "justgage",
    "fileMap": [
      {
        "basePath": "",
        "files": [
          "justgage*"
        ]
      },
      {
        "basePath": "dist",
        "files": [
          "justgage.umd*.js*"
        ]
      }
    ]
  },
  "authors": [
