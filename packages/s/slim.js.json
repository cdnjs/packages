{
  "name": "slim.js",
  "filename": "index.js",
  "description": "Superpower Web Components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eavichay/slim.js.git"
  },
  "license": "MIT",
  "homepage": "http://slimjs.com",
  "keywords": [
    "web",
    "components",
    "binding"
  ],
  "autoupdate": {
    "source": "npm",
    "target": "slim-js",
    "fileMap": [
      {
        "basePath": "",
        "files": [
          "{,directives/}*.@(js|ts)"
        ]
      },
      {
        "basePath": "dist",
        "files": [
          "*.js",
          "directives/*.js"
        ]
      }
    ],
    "ignoreVersions": [
      "1.*",
      "2.[0-5].*"
    ]
  },
  "authors": [
    {
      "name": "Avichay Eyal",
      "email": "eavichay@gmail.com"
    }
  ]
}
