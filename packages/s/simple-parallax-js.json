{
  "name": "simple-parallax-js",
  "description": "A lightweight React & vanilla JavaScript library that adds a parallax effect to any image.",
  "keywords": [
    "react",
    "react-parallax",
    "react-component",
    "parallax",
    "parallax-effect",
    "parallax-scroll",
    "parallax-image",
    "scroll-animation",
    "animation",
    "image",
    "typescript",
    "vanilla-js",
    "nextjs"
  ],
  "license": "MIT",
  "homepage": "https://simpleparallax.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geosigno/simpleParallax.js.git"
  },
  "authors": [
    {
      "name": "Geoffrey Signorato",
      "email": "geoffrey.signorato@gmail.com"
    }
  ],
  "autoupdate": {
    "source": "npm",
    "target": "simple-parallax-js",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "react/*.js",
          "vanilla/*.js"
        ]
      }
    ]
  },
  "filename": "vanilla/simpleParallaxVanilla.umd.js"
}
