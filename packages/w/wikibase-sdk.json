{
  "name": "wikibase-sdk",
  "description": "utils functions to query a Wikibase instance and simplify its results",
  "keywords": [
    "wikidata",
    "wikibase",
    "sdk",
    "api",
    "wdq",
    "sparql",
    "wbk"
  ],
  "license": "MIT",
  "homepage": "https://github.com/maxlath/wikibase-sdk",
  "repository": {
    "type": "git",
    "url": "git://github.com/maxlath/wikibase-sdk.git"
  },
  "autoupdate": {
    "source": "git",
    "target": "git://github.com/maxlath/wikibase-sdk.git",
    "fileMap": [
      {
        "basePath": "dist/src",
        "files": [
          "*.@(js|js.map)",
          "helpers/*.@(js|js.map)",
          "queries/*.@(js|js.map)",
          "types/*.@(js|js.map)",
          "utils/*.@(js|js.map)",
          "wellknown/*.@(js|js.map)"
        ]
      }
    ]
  },
  "filename": "index.js",
  "authors": [
    {
      "name": "maxlath"
    }
  ]
}
