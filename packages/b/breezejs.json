{
  "name": "breezejs",
  "filename": "breeze.js",
  "description": "BreezeJS is a JavaScript library for managing data in data rich-client HTML/JS applications. Core features include client-side querying, caching, change-tracking, validation, batch saves.",
  "homepage": "http://www.getbreezenow.com/",
  "keywords": [
    "data",
    "BreezeJS",
    "breeze",
    "breeze.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Breeze/breeze.js.git"
  },
  "license": "MIT",
  "autoupdate": {
    "source": "npm",
    "target": "breeze-client",
    "fileMap": [
      {
        "basePath": "",
        "files": [
          "breeze.js",
          "breeze.js.map",
          "adapters/*.js?(.map)",
          "angular/*.js?(.map)",
          "config/*.js?(.map)",
          "core/*.js?(.map)",
          "entity/*.js?(.map)",
          "manager/*.js?(.map)",
          "metadata/*.js?(.map)",
          "mixins/*.js?(.map)",
          "query/*.js?(.map)",
          "rxjs/*.js?(.map)",
          "validation/*.js?(.map)"
        ]
      },
      {
        "basePath": "build",
        "files": [
          "**/breeze*"
        ]
      }
    ]
  }
}
