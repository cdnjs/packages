{
  "name": "vexflow",
  "filename": "vexflow.js",
  "description": "A JavaScript library for rendering music notation and guitar tablature",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xfe/vexflow.git"
  },
  "license": "MIT",
  "homepage": "http://vexflow.com",
  "keywords": [
    "music",
    "notation",
    "guitar",
    "tablature"
  ],
  "autoupdate": {
    "source": "npm",
    "target": "vexflow",
    "fileMap": [
      {
        "basePath": "build/esm",
        "files": [
          "entry/vexflow.js",
          "src/*.js",
          "src/fonts/*.js"
        ]
      },
      {
        "basePath": "build/cjs",
        "files": [
          "vexflow!(*tests*).js",
          "vexflow!(*tests*).js.map"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "Mohit Muthanna Cheppudira",
      "email": "mohit@muthanna.com",
      "url": "https://muthanna.com"
    }
  ]
}
