{
  "name": "vazir-font",
  "description": "A Persian (Farsi) Font - قلم (فونت) فارسی وزیر",
  "keywords": [
    "font",
    "farsi",
    "persian"
  ],
  "license": "Public Domain",
  "homepage": "https://github.com/rastikerdar/vazir-font#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/rastikerdar/vazir-font.git"
  },
  "autoupdate": {
    "source": "git",
    "target": "git://github.com/rastikerdar/vazir-font.git",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      },
      {
        "basePath": "",
        "files": [
          "*.css",
          "misc/**/*.css",
          "Round-Dots/**/*.css",
          "fonts/webfonts/*.woff2",
          "misc/**/fonts/webfonts/*.woff2",
          "Round-Dots/**/fonts/webfonts/*.woff2"
        ]
      }
    ]
  },
  "filename": "Vazirmatn-font-face.css",
  "authors": [
    {
      "name": "Behnood Khani",
      "email": "behnood.reg@gmail.com"
    }
  ]
}
