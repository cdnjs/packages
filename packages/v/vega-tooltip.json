{
  "name": "vega-tooltip",
  "filename": "index.js",
  "description": "A tooltip plugin for Vega-lite and Vega visualizations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vega/vega-tooltip.git"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "visualization",
    "tooltip",
    "plugin"
  ],
  "autoupdate": {
    "source": "npm",
    "target": "vega-tooltip",
    "fileMap": [
      {
        "basePath": "build",
        "files": [
          "**/vega-tooltip*.+(js|css|map)"
        ]
      },
      {
        "basePath": "build",
        "files": [
          "index.js",
          "index.js.map"
        ]
      }
    ],
    "ignoreVersions": [
      "0.3.1"
    ]
  },
  "authors": [
    {
      "name": "Zening Qu, Sira Horradarn"
    }
  ]
}
