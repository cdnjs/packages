{
  "name": "uuid",
  "description": "RFC4122 (v1, v4, and v5) UUIDs",
  "keywords": [
    "uuid",
    "guid",
    "rfc4122"
  ],
  "license": "MIT",
  "homepage": "https://github.com/uuidjs/uuid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidjs/uuid.git"
  },
  "filename": "index.js",
  "autoupdate": {
    "source": "npm",
    "target": "uuid",
    "fileMap": [
      {
        "basePath": "dist/umd",
        "files": [
          "*.js"
        ]
      },
      {
        "basePath": "dist",
        "files": [
          "!(*uuid-bin).js"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "uuidjs contributors"
    }
  ]
}
