{
  "name": "pako",
  "description": "zlib port to javascript - fast, modularized, with browser support",
  "keywords": [
    "zlib",
    "deflate",
    "inflate",
    "gzip"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/nodeca/pako.git"
  },
  "filename": "browser/pako.umd.min.js",
  "autoupdate": {
    "source": "npm",
    "target": "pako",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      }
    ]
  },
  "authors": [
