{
  "name": "pixi-filters",
  "description": "Optional display filters to work with Pixi.js",
  "filename": "pixi-filters.js",
  "homepage": "https://pixijs.github.io/pixi-filters/docs/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixijs/pixi-filters.git"
  },
  "keywords": [
    "pixi",
    "filter",
    "AsciiFilter",
    "BloomFilter",
    "ConvolutionFilter",
    "CrossHatchFilter",
    "DotFilter",
    "EmbossFilter",
    "PixelateFilter",
    "RGBSplitFilter",
    "ShockwaveFilter",
    "TiltShiftFilter",
    "TwistFilter"
  ],
  "autoupdate": {
    "source": "npm",
    "target": "pixi-filters",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "pixi-filters.js",
          "pixi-filters.js.map",
          "pixi-filters.mjs",
          "pixi-filters.mjs.map"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "Mat Groves"
    }
  ]
}
