{
  "name": "chrono-node",
  "filename": "index.js",
  "description": "A natural language date parser in Javascript",
  "keywords": [
    "parser",
    "time",
    "npl",
    "chrono"
  ],
  "homepage": "https://wanasit.github.io/pages/chrono/",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanasit/chrono.git"
  },
  "license": "MIT",
  "autoupdate": {
    "source": "npm",
    "target": "chrono-node",
    "fileMap": [
      {
        "basePath": "dist/esm",
        "files": [
          "*.@(js|js.map)",
          "calculation/*.@(js|js.map)",
          "common/*.@(js|js.map)",
          "common/parsers/*.@(js|js.map)",
          "common/refiners/*.@(js|js.map)",
          "utils/*.@(js|js.map)",
          "locales/*/*.@(js|js.map)",
          "locales/*/parsers/*.@(js|js.map)",
          "locales/*/refiners/*.@(js|js.map)",
          "locales/zh/hans/*.@(js|js.map)",
          "locales/zh/hans/parsers/*.@(js|js.map)",
          "locales/zh/hans/refiners/*.@(js|js.map)",
          "locales/zh/hant/*.@(js|js.map)",
          "locales/zh/hant/parsers/*.@(js|js.map)",
          "locales/zh/hant/refiners/*.@(js|js.map)"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "Wanasit Tanakitrungruang"
    }
  ]
}
