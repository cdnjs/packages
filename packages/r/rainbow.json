{
  "name": "rainbow",
  "filename": "rainbow.min.js",
  "description": "Simple library for code syntax highlighting",
  "homepage": "http://craig.is/making/rainbows/",
  "keywords": [
    "code",
    "syntax",
    "highlighting"
  ],
  "autoupdate": {
    "source": "git",
    "target": "git://github.com/ccampbell/rainbow.git",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "rainbow.js",
          "rainbow.min.js"
        ]
      },
      {
        "basePath": "",
        "files": [
          "themes/css/*.css"
        ]
      },
      {
        "basePath": "src",
        "files": [
          "language/*.js"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ccampbell/rainbow.git"
  },
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Craig Campbell"
    }
  ]
}
