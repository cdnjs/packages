{
  "name": "react-widgets",
  "description": "An à la carte set of polished, extensible, and accessible inputs built for React",
  "filename": "react-widgets.js",
  "keywords": [
    "react",
    "widgets",
    "dropdown",
    "combobox",
    "calendar",
    "datepicker",
    "date picker",
    "numberpicker",
    "number picker",
    "radio group",
    "checkbox list",
    "multiselect",
    "form",
    "input",
    "react-ui",
    "react-component"
  ],
  "homepage": "https://jquense.github.io/react-widgets/docs/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jquense/react-widgets"
  },
  "autoupdate": {
    "source": "npm",
    "target": "react-widgets",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      },
      {
        "basePath": "umd",
        "files": [
          "*.js",
          "*.js.map"
        ]
      },
      {
        "basePath": "",
        "files": [
          "styles.css",
          "styles.css.map"
        ]
      }
    ]
  },
  "authors": [
    {
      "name": "Jason",
      "email": "monastic.panic@gmail.com"
    }
  ]
}
