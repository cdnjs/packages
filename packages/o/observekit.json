    "url": "https://github.com/oyzamil/observekit.git"
  },
  "keywords": [
    "mutation-observer",
	"resize-observer",
	"intersection-observer",
	"performance-observer",
	"reporting-observer",
	"dom",
	"arrive",
	"arrive.js",
	"observer",
	"browser-extension"
  ],
  "license": "MIT",
  "autoupdate": {
    "source": "git",
    "target": "git://github.com/oyzamil/observekit.git",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "observekit*"
        ]
      },
      {
        "basePath": "src",
        "files": [
          "observekit*"
        ]
      }
    ]
  },
  "authors": [
