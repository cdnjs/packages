{
  "name": "node-vibrant",
  "filename": "browser.js",
  "description": "Extract prominent colors from an image. Supports both node and browser environment.",
  "keywords": [
    "color",
    "detection",
    "varation",
    "image",
    "picture",
    "canvas",
    "vibrant",
    "muted",
    "colour"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akfish/node-vibrant.git"
  },
  "autoupdate": {
    "source": "npm",
    "target": "node-vibrant",
    "fileMap": [
      {
        "basePath": "dist",
        "files": ["*.js"]
      },
      {
        "basePath": "dist/esm",
        "files": [
          "browser.js",
          "browser.js.map",
          "configs/browser.js",
          "configs/browser.js.map",
          "configs/config.js",
          "configs/config.js.map",
          "pipeline/index.js",
          "pipeline/index.js.map",
          "worker.js",
          "worker.js.map",
          "worker.worker.js",
          "worker.worker.js.map"
        ]
      }
    ]
  },
  "license": "MIT",
  "authors": [
    {
      "name": "akfish"
    }
  ]
}
