{
  "name": "numbro",
  "description": "Format and manipulate numbers.",
  "homepage": "http://numbrojs.com",
  "keywords": [
    "numeral",
    "numbro",
    "number",
    "format",
    "time",
    "money",
    "percentage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BenjaminVanRyseghem/numbro"
  },
  "autoupdate": {
    "source": "npm",
    "target": "numbro",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "*.@(js|map)",
          "languages/*.@(js|map)",
          "es/*.js",
          "es/languages/*.js",
          "dependencies.txt"
        ]
      }
    ]
  },
  "filename": "numbro.min.js",
  "license": "MIT",
  "authors": [
    {
      "name": "Benjamin Van Ryseghem",
      "email": "benjamin@vanryseghem.com",
      "url": "https://benjamin.vanryseghem.com"
    }
  ]
}
